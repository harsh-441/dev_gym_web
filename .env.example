# PARSHURAM FITNESS GYM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or set in your deployment dashboards (Vercel & Supabase)

# 1. Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-on-client
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Mobile app API origin, for example https://gym.example.com (no trailing slash)
EXPO_PUBLIC_API_URL=https://your-gym-website.example.com

# 2. OpenAI API Credentials (Optional - server uses deterministic sports science engine if unset)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 3. Gym Settings Defaults (Can be modified dynamically by Dave in Admin Settings)
NEXT_PUBLIC_GYM_NAME="PARSHURAM FITNESS GYM"
NEXT_PUBLIC_GYM_TAGLINE="INSPIRED BY DIVINITY. BUILT THROUGH DISCIPLINE."
NEXT_PUBLIC_GYM_OWNER="Dave"

# 4. Email Notification Service (Resend / SendGrid / Postmark - Optional)
EMAIL_SERVICE_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@parshuramgym.com
DAVE_NOTIFICATION_EMAIL=dave@parshuramgym.com

# 5. Push Notification Service (Expo Push Notifications)
EXPO_ACCESS_TOKEN=
